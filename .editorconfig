# 편집기 공통 모양. 코드 모양(따옴표·세미콜론·끝 쉼표·한 줄 길이)은 Prettier(.prettierrc)가 맡고 웹과 같다.
root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true
indent_style = space
indent_size = 2

[*.{md,mdx}]
trim_trailing_whitespace = false

# static/은 받아 온 파일(글꼴·라이선스·예시 이미지)이라 받은 그대로 둔다
[static/**]
trim_trailing_whitespace = false
